{
  "name": "spindle-gripper-automation",
  "private": true,
  "version": "1.4.0",
  "description": "Gimbel Automation spindle gripper / QuickFlip180 two-op programming and fixture tool",
  "author": "Gimbel Automation",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "installer": "vite build && node scripts/build-installer.mjs"
  },
  "build": {
    "appId": "com.gimbelautomation.spindle-gripper",
    "productName": "Spindle Gripper Automation",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "CAD Files",
        "to": "CAD Files"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Spindle Gripper Setup ${version}.exe"
    }
  },
  "dependencies": {
    "occt-import-js": "^0.0.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "replicad": "^0.23.1",
    "replicad-opencascadejs": "^0.23.0",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
